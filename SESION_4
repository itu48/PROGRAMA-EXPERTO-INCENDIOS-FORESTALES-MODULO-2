2: Filtro y Fijación de Imágenes (Pre y Post-Fuego)------------Continuamos con el codigo 1
// Cargar colección de Sentinel-2 L2A
var s2 = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED');

// --- PASO A: FIJAR LA POST-IMAGEN (Inmediatamente tras la extinción) ---
var postFuegoCompuesto = s2
  .filterBounds(aoi)
  .filterDate('2025-10-15', '2025-11-05') // Rango posterior a la extinción
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 15)) // Filtro estricto de nubes
  .median() // Reductor estadístico para limpiar nubes residuales
  .clip(aoi);

// --- PASO B: FIJAR LA PRE-IMAGEN (Línea Base - Época seca temprana) ---
var preFuegoCompuesto = s2
  .filterBounds(aoi)
  .filterDate('2025-06-01', '2025-07-15') // Época seca temprana para mitigar la sequía estacional
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 15))
  .median()
  .clip(aoi);

// Visualización en Falso Color Infrarrojo (SWIR/NIR/Red) óptimo para ver cicatrices de quema
var visS2 = {bands: ['B12', 'B8', 'B4'], min: 500, max: 4000};

Map.addLayer(preFuegoCompuesto, visS2, '1. Imagen Pre-Fuego (Línea Base)');
Map.addLayer(postFuegoCompuesto, visS2, '2. Imagen Post-Fuego (Cicatriz oscura)');
